{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ScholarSpark AI (Full-Stack Dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "preLaunchTask": "Ensure Dependencies Installed",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development",
        "PORT": "3000"
      }
    },
    {
      "name": "Run ScholarSpark AI + Open Browser",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "preLaunchTask": "Ensure Dependencies Installed",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "ScholarSpark AI server running on http://0\\.0\\.0\\.0:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
