{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.eol": "\n",
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "tailwindCSS.experimental.classRegex": [
    ["className\\s*=\\s*[\"'`]([^\"'`]*)[\"'`]", "([^\"'`]*)"]
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/docs": true
  }
}
