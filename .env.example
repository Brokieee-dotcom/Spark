# GEMINI_API_KEY: Required for Gemini AI API calls (SERVER-SIDE ONLY).
# AI Studio automatically injects this at runtime from user secrets.
# In Production/Cloud Run: Set as an environment secret in Google Secret Manager or Cloud Run env vars.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# PORT: The port the full-stack server listens on (AI Studio dev uses 3000)
PORT="3000"

# NODE_ENV: 'development' or 'production'
NODE_ENV="production"

# APP_URL: The public URL where this applet is hosted.
APP_URL="https://your-cloud-run-url.run.app"

# ALLOWED_ORIGINS: Comma-separated allowed CORS origins if hosting the frontend on GitHub Pages
# Example: ALLOWED_ORIGINS="https://your-username.github.io"
ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Optional public URL of your deployed backend server when hosting the static frontend on GitHub Pages.
# Leave empty when running full-stack on the same origin (AI Studio / Cloud Run).
VITE_API_BASE_URL=""

# VITE_BASE_PATH: Optional Vite base path (defaults to './' which works on both root and GitHub Pages subpaths)
VITE_BASE_PATH="./"
