# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# In Google AI Studio: Configure this via the Settings > Secrets panel.
# In Production/Cloud Run: Set as an environment secret in Google Secret Manager or Cloud Run env vars.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# PORT: The port the full-stack server listens on (Cloud Run defaults to 8080, AI Studio dev to 3000)
PORT="3000"

# NODE_ENV: 'development' or 'production'
NODE_ENV="production"

# APP_URL: The public URL where this applet is hosted.
# Automatically provided in Google Cloud Run.
APP_URL="https://your-cloud-run-url.run.app"
